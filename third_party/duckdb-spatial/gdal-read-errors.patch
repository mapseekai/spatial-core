+// A driver may clear/replace CPL's last error while finishing a partial Arrow batch.
+class GDALReadErrorScope {
+public:
+	GDALReadErrorScope() {
+		CPLErrorReset();
+		CPLPushErrorHandlerEx([](CPLErr severity, int, const char *message) {
+			auto &scope = *static_cast<GDALReadErrorScope *>(CPLGetErrorHandlerUserData());
+			scope.failed |= severity >= CE_Failure;
+			// Preserve the existing fatal-error policy: GDAL otherwise aborts after this callback.
+			if (severity == CE_Fatal) {
+				throw InternalException("Fatal GDAL error: " + CleanGDALMessage(message));
+			}
+		}, this);
+	}
+	~GDALReadErrorScope() {
+		CPLPopErrorHandler();
+	}
+	bool Failed() const {
+		return failed || CPLGetLastErrorType() >= CE_Failure;
+	}
+	GDALReadErrorScope(const GDALReadErrorScope &) = delete;
+	GDALReadErrorScope &operator=(const GDALReadErrorScope &) = delete;
+private:
+	bool failed = false;
+};
